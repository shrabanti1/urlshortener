# Copy to .env and adjust. .env is gitignored and must never be committed.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=urlshortener
DB_PASSWORD=changeme
DB_POOL_SIZE=4

APP_HOST=127.0.0.1
APP_PORT=8080
BASE_URL=http://localhost:8080

DB_TIMEOUT_SEC=5

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=4
REDIS_TTL_SECONDS=3600
CACHE_ENABLED=true
LOG_LEVEL=INFO
REDIS_TIMEOUT_SEC=1
REDIS_BREAKER_FAILURES=3
REDIS_BREAKER_COOLOFF_SEC=10
